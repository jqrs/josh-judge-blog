<!DOCTYPE html>
<html lang="{{ site.language }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{{ seo_description or description or site.description }}">
        <title>{{ browser_title or title }}{% if (browser_title or title) != site.name %} — {{ site.name }}{% endif %}</title>
        {% if not noindex %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% else %}<meta name="robots" content="noindex">{% endif %}
        <meta property="og:type" content="{% if tags and 'post' in tags %}article{% else %}website{% endif %}">
        <meta property="og:title" content="{{ title }}">
        <meta property="og:description" content="{{ seo_description or description or site.description }}">
        <meta property="og:url" content="{{ site.url }}{{ page.url }}">
        <link rel="stylesheet" href="/style.css">
        <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
        <script src="/photos.js" defer></script>
    </head>
    <body>
        <header class="site-header">
            <p class="site-title"><a href="/">{{ site.name }}<span>{{ site.logo_suffix }}</span></a></p>
            <nav aria-label="{{ site.navigation_label }}">
                {% for item in site.navigation %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}
            </nav>
        </header>
        <main>{{ content | safe }}</main>
        <dialog id="photo-viewer" aria-label="{{ site.photo_viewer.label }}" data-separator="{{ site.photo_viewer.count_separator }}">
            <div class="viewer-panel">
                <div class="viewer-toolbar">
                    <span data-viewer-count aria-live="polite"></span>
                    <button type="button" data-viewer-close autofocus>{{ site.photo_viewer.close }}</button>
                </div>
                <figure class="viewer-figure">
                    <img data-viewer-image alt="">
                    <p data-viewer-error hidden>{{ site.photo_viewer.error }}</p>
                    <figcaption data-viewer-caption aria-live="polite"></figcaption>
                </figure>
                <div class="viewer-navigation">
                    <button type="button" data-viewer-previous>{{ site.photo_viewer.previous }}</button>
                    <button type="button" data-viewer-next>{{ site.photo_viewer.next }}</button>
                </div>
            </div>
        </dialog>
        <footer class="site-footer">
            <p>&copy; {{ site.footer_year or ('' | year) }} {{ site.footer_name }}</p>
            {% if site.footer_html %}<div class="footer-note">{{ site.footer_html | safe }}</div>{% endif %}
        </footer>
    </body>
</html>
